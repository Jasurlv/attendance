# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://attendance:attendance@localhost:5432/attendance?schema=public"

# Secret used to sign login cookies. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# First admin account, created by `npm run db:seed`
ADMIN_NAME="Director"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"
